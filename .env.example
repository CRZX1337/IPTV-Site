# HOODTV configuration
# Copy to .env and fill in your Xtream provider details.

# Xtream server base URL (no trailing slash, no path).
# The backend talks to this server exclusively - credentials never reach the browser.
XTREAM_HOST=http://your-iptv-provider.example:8080
XTREAM_USERNAME=your_xtream_username
XTREAM_PASSWORD=your_xtream_password

# Port for the HOODTV server
PORT=8080

# How long a session stays valid (ms). Default: 24h
SESSION_TTL_MS=86400000

# Minutes a user must wait after the last admin activity before they may switch channels
USER_IDLE_MINUTES=30

# Channel/category list cache TTL (ms)
CHANNEL_CACHE_MS=60000

# EPG cache TTL (ms)
EPG_CACHE_MS=30000

# Proxy token lifetime for stream playlist/segment URLs (ms)
PROXY_TOKEN_TTL_MS=180000
